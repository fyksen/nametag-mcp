# Copy to .env and replace the secrets before starting the containers.
DB_NAME=nametag
DB_USER=nametag
DB_PASSWORD=change-this-database-password
DB_PORT=5432
APP_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CRON_SECRET=replace-with-a-random-secret-of-at-least-16-characters

# MCP connection. Create a personal API token in Nametag: Settings > API Tokens.
NAMETAG_URL=http://localhost:3000
NAMETAG_API_TOKEN=ntag_replace_with_your_token

# Remote HTTP transport. For stdio-only MCP clients, leave MCP_TRANSPORT=stdio.
# For a LAN deployment, use HTTP behind an HTTPS reverse proxy or configure TLS cert/key.
MCP_TRANSPORT=stdio
MCP_AUTH_TOKEN=replace-with-at-least-32-random-characters
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Exact Host headers, e.g. mcp.example.lan or mcp.example.lan:8443.
MCP_ALLOWED_HOSTS=
# Optional browser Origins; requests without Origin (e.g. native MCP clients) are allowed.
MCP_ALLOWED_ORIGINS=
# Only true when an HTTPS reverse proxy is the sole path to the MCP service.
MCP_TRUSTED_PROXY=false
# Compose can point at a different Nametag via MCP_NAMETAG_URL; default is its local service.
# MCP_NAMETAG_URL=https://nametag.example.lan
