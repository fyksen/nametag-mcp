# MCP connection. Use the reachable URL of an existing Nametag instance.
NAMETAG_URL=https://nametag.example.lan
# Create this in Nametag under Settings > API Tokens. READ scope is enough for read-only use.
NAMETAG_API_TOKEN=ntag_replace_with_your_token

# Transport: stdio for MCP clients that launch this process; http for remote MCP clients.
MCP_TRANSPORT=stdio
# Required in HTTP mode. Generate a separate secret (e.g. `openssl rand -hex 32`).
MCP_AUTH_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Exact Host headers allowed by the HTTP server, e.g. mcp.example.lan or mcp.example.lan:8443.
MCP_ALLOWED_HOSTS=
# Optional Origin allowlist; requests without Origin (e.g. native MCP clients) are allowed.
MCP_ALLOWED_ORIGINS=
# Enable only behind an HTTPS reverse proxy that is the sole network path to this service.
MCP_TRUSTED_PROXY=false
# For direct HTTPS instead of a TLS-terminating proxy, provide both certificate and key paths.
# MCP_TLS_CERT=/etc/nametag-mcp/tls.crt
# MCP_TLS_KEY=/etc/nametag-mcp/tls.key
# Never enable for a production/LAN deployment.
MCP_ALLOW_INSECURE_HTTP=false
